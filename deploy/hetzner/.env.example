# Copy to .env (same directory), fill in, then: chmod 600 .env
# .env is git-ignored. Every BTF_* variable is documented in README.md, "Configuration".

# --- Used by Caddy (docker-compose.yml) ---
# Public hostname; its A (and AAAA) record must point at this server before the first start.
BTF_DOMAIN=petition.example.org
# Contact address for the ACME (Let's Encrypt) account: expiry and problem notices.
ACME_EMAIL=ops@example.org

# --- Passed to the app container ---
# REQUIRED for export/erase. At least 24 characters, or the admin endpoints stay disabled (404).
# Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
BTF_ADMIN_TOKEN=

# torch threads = vCPUs of the server (CPX22: 2).
BTF_MODEL_THREADS=2
# Scans decoding/inferring at once. 2 fits 4 GB; see docs/DEPLOY.md before raising it.
BTF_SCAN_CONCURRENCY=2
BTF_PETITION_GOAL=10000
# If you change this, also change request_body max_size in the Caddyfile.
BTF_MAX_UPLOAD_MB=50
